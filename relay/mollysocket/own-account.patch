+/// Ivy: the 16 bytes of a UUID written as text.
+fn aci_bytes(uuid: &str) -> Option<Vec<u8>> {
+    let hex: String = uuid.chars().filter(|c| *c != '-').collect();
+    if hex.len() != 32 {
+        return None;
+    }
+    (0..16)
+        .map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).ok())
+        .collect()
+}
+
+#[cfg(test)]
+mod ivy_tests {
+    use super::*;
+
+    fn envelope(source: Option<&str>) -> Envelope {
+        Envelope {
+            source_service_id: source.map(String::from),
+            urgent: Some(true),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn own_account_is_recognised() {
+        let ws = SignalWebSocket::new(
+            "0F3C9A12-5B7D-4E21-9C44-7A1B2C3D4E5F",
+            2,
+            "pw",
+            "http://ivy-gateway:8080/apns/ab",
+        )
+        .unwrap();
+        assert!(ws.is_from_own_account(&envelope(Some("0f3c9a12-5b7d-4e21-9c44-7a1b2c3d4e5f"))));
+        assert!(ws.is_from_own_account(&envelope(Some("ACI:0f3c9a12-5b7d-4e21-9c44-7a1b2c3d4e5f"))));
+        assert!(!ws.is_from_own_account(&envelope(Some("5f0c2b6e-0000-4000-8000-000000000001"))));
+        assert!(!ws.is_from_own_account(&envelope(None)), "sealed sender messages have no source");
+
+        let mut own = envelope(None);
+        own.source_service_id_binary = aci_bytes("0f3c9a12-5b7d-4e21-9c44-7a1b2c3d4e5f");
+        assert!(ws.is_from_own_account(&own), "the server sends the sender as 16 bytes");
+        let mut other = envelope(None);
+        other.source_service_id_binary = aci_bytes("5f0c2b6e-0000-4000-8000-000000000001");
+        assert!(!ws.is_from_own_account(&other));
+        let mut pni = envelope(None);
+        let mut bytes = vec![1u8];
+        bytes.extend(aci_bytes("0f3c9a12-5b7d-4e21-9c44-7a1b2c3d4e5f").unwrap());
+        pni.source_service_id_binary = Some(bytes);
+        assert!(!ws.is_from_own_account(&pni), "a PNI with the same UUID isn't the ACI");
+    }
+}
