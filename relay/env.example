# Copy to .env and fill in.
IVY_RELAY_DOMAIN=relay.example.com
# developer.apple.com > Membership details > Team ID
APNS_TEAM_ID=5G876UXS5R
# developer.apple.com > Keys > your push key > Key ID
APNS_KEY_ID=ABCDE12345
# Password for the status page at https://<domain>/admin (user "admin").
# Create one with: openssl rand -base64 24
IVY_ADMIN_PASSWORD=
# Optional: only these accounts may use the relay (Ivy shows the ID under
# Settings > Notifications > Push Relay). Without it, every Ivy account may.
# IVY_ALLOWED_ACCOUNTS=["00000000-0000-0000-0000-000000000000"]
