# Only MollySocket and the gateway's admin page are reachable from outside;
# the gateway's push endpoint and MollySocket's metrics stay internal.
{$IVY_RELAY_DOMAIN} {
	handle /admin* {
		reverse_proxy ivy-gateway:8080
	}
	handle /metrics* {
		respond 404
	}
	handle {
		reverse_proxy h2c://mollysocket:8020
	}
}
