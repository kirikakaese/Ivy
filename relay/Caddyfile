# From outside, only MollySocket's registration, the public status page and
# the admin page are reachable. The gateway's push endpoint and MollySocket's
# metrics stay inside the Docker network.
{$IVY_RELAY_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 64KB
	}

	# Visitors opening the address see the status page; MollySocket's own
	# start page is for Molly on Android. Ivy registers with POST /.
	@startPage {
		path /
		method GET HEAD
	}
	redir @startPage /status/ 302

	handle /status* {
		reverse_proxy ivy-gateway:8080
	}
	handle /admin* {
		reverse_proxy ivy-gateway:8080
	}
	handle /metrics* {
		respond 404
	}
	handle /apns* {
		respond 404
	}
	handle {
		reverse_proxy h2c://mollysocket:8020
	}
}
