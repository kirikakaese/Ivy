# Two addresses:
# - IVY_RELAY_DOMAIN: where Ivy registers with MollySocket. Its old status
#   and admin addresses forward to the status address.
# - IVY_STATUS_DOMAIN: the Ivy Status page and, under /admin, the admin page.
# The gateway's push endpoint and MollySocket's metrics stay inside the
# Docker network.

(common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 64KB
	}
}

{$IVY_RELAY_DOMAIN} {
	import common

	# Visitors opening the address see the status page; MollySocket's own
	# start page is for Molly on Android. Ivy registers with POST /.
	@startPage {
		path /
		method GET HEAD
	}
	redir @startPage https://{$IVY_STATUS_DOMAIN}/ 302
	# Ivy reads the status data from the relay it uses; the page itself
	# lives at the status address.
	@statusPage {
		path /status*
		not path /status/status.json
	}
	redir @statusPage https://{$IVY_STATUS_DOMAIN}/ 302
	redir /admin* https://{$IVY_STATUS_DOMAIN}/admin/ 302

	handle /metrics* {
		respond 404
	}
	handle /apns* {
		respond 404
	}
	handle /status/status.json {
		reverse_proxy ivy-gateway:8080
	}
	handle {
		reverse_proxy h2c://mollysocket:8020
	}
}

{$IVY_STATUS_DOMAIN} {
	import common

	redir /status / 302
	redir /status/ / 302

	handle /admin* {
		reverse_proxy ivy-gateway:8080
	}
	# The gateway serves the public page under /status/.
	handle {
		rewrite * /status{path}
		reverse_proxy ivy-gateway:8080
	}
}
