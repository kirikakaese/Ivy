// The upstream Signal-iOS release Ivy is built on. Ivy reports exactly this
// version to Signal's servers, in the same form as the official client
// (8.35.1.1964). Update both values with every upstream merge.
IVY_UPSTREAM_MARKETING_VERSION = 8.35.1
IVY_UPSTREAM_BUILD_NUMBER = 1964

// Counts Ivy's builds of that release, after the upstream build number
// (1910.42). TestFlight needs a new number for every upload; CI sets it to
// the run number. Signal's servers only see the upstream build number.
IVY_BUILD = 0

// The push relay Ivy connects to by itself (docs/PUSH_RELAY.md), as a host
// name without https:// since xcconfig treats // as a comment. Empty means
// none; users can still enter a relay by hand. TestFlight builds take it from
// the repository variable IVY_PUSH_RELAY_HOST.
IVY_PUSH_RELAY_HOST =
